
@{
    ViewData["Title"] = "Customers";
}

<h2>Customers</h2>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Orders Count</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var customer in Model)
        {
            <tr>
                <td>@customer.FullName</td>
                <td>@customer.Email</td>
                <td>@(customer.Orders?.Count ?? 0)</td>
                <td>
                    <a asp-action="Details" asp-route-id="@customer.Id">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>
