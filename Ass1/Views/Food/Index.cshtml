@model IEnumerable<Food>
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@if (User.IsInRole("Admin"))
{

<div class="m-5">
    <a class="btn btn-outline-primary" asp-action="Create">Add Food</a>
</div>
}
@if (TempData["SuccessMsg"] != null)
{
    <div>@TempData["SuccessMsg"]</div>
}
<table>
    <thead>
        <tr>
            <th>Food Name</th>
            <th>Category Name</th>
            <th>Price</th>
            <th>Description</th>
            <th>Image</th>
            <th>Actions</th>
        </tr>
        

    </thead>
    <tbody>
        @foreach(var item in Model)
        {
            <tr id="food-row-@item.Id">
            <td>@item.Name</td>
            <td>@item.Category.Name</td>
            <td>@item.Price</td>
            <td>@item.Description</td>
            <td>
                <img src="/@Url.Content(item.ImageUrl)" />
            </td>
            
            <td>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-warning">Details</a>
            </td>
    @if (User.IsInRole("Admin"))
    {
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" asp-route-from="Index" class="btn btn-success">Edit</a>
            </td>
            <td>
                    <button onclick="deleteFood('@Url.Action("Delete", "Food" , new { id=item.Id})','index')" type="submit" class="btn btn-danger">Delete</button>
            </td>
    }
            </tr>
        }
        
    </tbody>
</table>