@model RestaurantApplication.ViewModel.FoodVM
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}


<form asp-action="Create" class="form" enctype="multipart/form-data">
    
    <div>
        <label asp-for="Name"></label>
        <input class="form-control" asp-for="Name"/>
        <span asp-validation-for="Name"></span>
    </div>
    <div>
        <label asp-for="Description"></label>
        <input class="form-control" asp-for="Description"/>
        <span asp-validation-for="Description"></span>
    </div>
    <div>
        <label asp-for="Price"></label>
        <input class="form-control" asp-for="Price" />
        <span asp-validation-for="Price"></span>
    </div>
    <div>
        <label asp-for="ImageFile"></label>
        <input type="file" class="form-control" asp-for="ImageFile" />
        <span asp-validation-for="ImageFile"></span>
    </div>
    <div>
        <label asp-for="CategoryId"></label>
        <select class="form-control" asp-for="CategoryId" asp-items="@Model.CategoryList">
            <option value="" hidden>-- Choose Category --</option>
            </select>
        <span asp-validation-for="CategoryId"></span>
    </div>
    <button class="btn btn-success" type="submit">Save</button>
</form>